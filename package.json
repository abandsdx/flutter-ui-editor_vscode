{
  "name": "ui-dragger",
  "displayName": "UI Dragger",
  "description": "A VS Code extension for drag-and-drop UI editing.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:ui-dragger.openEditor"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ui-dragger.openEditor",
        "title": "Open UI Dragger Editor"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node_modules/.bin/webpack",
    "watch": "node_modules/.bin/webpack --watch",
    "package": "node_modules/.bin/webpack --mode production --devtool hidden-source-map",
    "compile-tests": "node_modules/.bin/tsc -p . --outDir out",
    "watch-tests": "node_modules/.bin/tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "node_modules/.bin/eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.103.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2",
    "ts-loader": "^9.5.4",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
